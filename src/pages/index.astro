---
import { getCollection } from "astro:content";
import PostPreview from "../components/PostPreview.astro";
import SocialMediaIcons from "../components/SocialMediaIcons.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortMDByDate } from "../utils";
import type { WorkExperience } from "../data/work-experience";

const MAX_POSTS = 10;
const allPosts = await getCollection("blog");
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);

const techStack: Record<string, string> = {
  cpp: "C++",
  csharp: "C#",
  java: "Java",
};

const projects: Array<{
  title: string;
  description: string;
  link: string;
  icon: string;
}> = [
  {
    title: "Tetris clone",
    description: "Implementación del clásico juego de puzles centrada en lógica de rotación, colisiones, gestión de estados y control preciso del ritmo de juego",
    link: "https://github.com/marcar-v/Tetris",
  },
  {
    title: "Frog Plataform 2D",
    description: "Juego de plataformas con físicas, saltos y movimiento lateral, enfocado en el diseño de niveles y la respuesta del control.",
    link: "https://github.com/marcar-v/plataformas-2d",
  },
    {
    title: "Jelix Hump",
    description: "uego casual basado en físicas donde el jugador controla el entorno, trabajando detección de colisiones, progresión y dificultad incremental.",
    link: "https://github.com/marcar-v/helix-jump",
  },
    {
    title: "VR Experience (Unreal Engine)",
    description: "Experiencia inmersiva en Unreal Engine centrada en interacción en realidad virtual, locomoción básica y optimización del rendimiento..",
    link: "https://github.com/marcar-v/M06-UnrealEngine",
  },
];
---

interface Props {
  data: WorkExperience;
}

const { data } = Astro.props;
---

<div
  class={`${
    data.active ? "bg-gray-900" : "bg-zinc-800"
  } flex flex-col shadow-2xl drop-shadow-xl rounded-lg my-6 pb-4`}
>
  <div
    class={`${
      data.active ? "bg-gray-800" : "bg-zinc-700"
    } py-2 px-6 rounded-tr-lg rounded-tl-lg flex flex-row flex-wrap justify-between`}
  >
    <span class="font-bold text-gray-200 text-sm md:text-md">
      {data.title} @ {data.company}
    </span>
    <span class="font-bold text-cyan-300 text-sm">
      {data.startDate} - {data.endDate}
    </span>
  </div>
  <div class="text-xs md:text-sm py-4 px-6">
    <div class="flex flex-col md:flex-row flex-wrap text-gray-200">
      <span class="font-bold">📍 {data.location}</span>
      <span class="font-bold mt-1 md:mt-0 md:ml-8 break-all">
        🌐{" "}
        <a href={data.website} target="_blank">
          {data.website.replace("https://", "")}
        </a>
      </span>
    </div>
    <p class="mt-3 text-justify">{data.description}</p>
  </div>
  <div class="mx-4">
    {
      data.technologies.map((technology) => (
        <span class="kbd kbd-sm hover:shadow-xl hover:scale-110 duration-150 mx-1 mt-2">{`${technology}`}</span>
      ))
    }
  </div>
</div>

<BaseLayout navbarActiveItemID="home">
  <main>
    <section id="about" class="mt-6" aria-labelledby="about-heading">
      <div
        class="bg-black/30 border border-gray-600 rounded-lg font-mono text-sm p-6"
        role="region"
      >
        <!-- Terminal header -->
        <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-600">
          <div class="flex gap-2" role="img">
            <div class="w-3 h-3 rounded-full bg-red-500"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
          </div>
          <span class="text-gray-400 text-xs ml-2"
            >terminal - ssh guest@terminus</span
          >
        </div>

        <!-- Content -->
        <div class="text-xs">
          <div class="space-y-2">
            <div class="flex items-center gap-4 mb-4">
              <p class="text-3xl">🎮</p>
              <div class="flex flex-col">
                <h1 class="text-primary text-xl">Violeta Martín</h1>
                <p class="text-gray-400 text-xs">
                  Desarrolladora de videojuegos
                </p>
              </div>
            </div>

            <!-- Personal paragraph -->
            <div class="bg-gray-500/10 rounded-lg p-3 mb-4">
              <p class="text-gray-200 leading-relaxed">
                Bienvenida a mi portfolio como desarrolladora de videojuegos. Este espacio recoge mis proyectos, experimentos y aprendizajes, con un enfoque en narrativa interactiva y diseño de gameplay. Aquí documento mi trabajo con distintos motores y tecnologías, así como mi evolución como creadora de experiencias jugables.
              </p>
            </div>

            <div class="border-b border-gray-600 w-full mb-2"></div>

            <div class="flex">
              <span class="text-gray-400 w-36 shrink-0">Location</span>
              <span class="text-white">Granada, España 🌍</span>
            </div>

            <div class="flex">
              <span class="text-gray-400 w-36 shrink-0">Work</span>
              <span class="text-white">
                Desarrolladora de videojuegos
                
              </span>
            </div>

            <div class="flex">
              <span class="text-gray-400 w-36 shrink-0">Interests</span>
              <span class="text-white"
                >Tecnología y programación, videojuegos (análisis y diseño), Juegos de mesa y diseño de mecánicas, lectura, especialmente ficción y narrativa</span
              >
            </div>

            <div class="flex">
              <span class="text-gray-400 w-36 shrink-0">Contact</span>
              <span class="text-white">
                <a
                  class="text-cyan-600 hover:underline focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:ring-offset-2 focus:ring-offset-gray-900"
                  href="mailto:violetamartinc@gmail.com"
                  aria-label="Send email to violetamartinc@gmail.com">violetamartinc@gmail.com</a
                >
              </span>
            </div>

            <div class="flex items-center">
              <span class="text-gray-400 w-36 shrink-0">Social</span>
              <span class="text-white flex-1 min-w-0">
                <SocialMediaIcons />
              </span>
            </div>

            <div class="pt-2">
              <div class="flex items-center">
                <span class="text-gray-400 w-36 shrink-0">Tech</span>
                <div class="flex flex-wrap gap-2" role="list" aria-label="Tech">
                  {
                    Object.keys(techStack).map((lang) => (
                      <span
                        class="text-gray-400 hover:text-cyan-600 transition-colors"
                        title={techStack[lang]}
                      >
                        {lang}
                      </span>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-3 pt-2 border-t border-gray-700 text-gray-500 text-xs">
          <span class="text-gray-400">$</span> cat about.txt
        </div>
      </div>
    </section>

    <section id="projects" class="mt-2">
      <div
        class="bg-black/20 border border-gray-700 rounded font-mono text-sm text-gray-300 p-6"
        role="region"
        aria-label="Project showcase"
      >
        <h2 class="mb-4 text-sm font-bold text-gray-500">👾 mis proyectos</h2>
        <div class="space-y-2" role="list">
          {
            projects.map((project, index) => (
              <div
                class="group hover:bg-gray-800/50 p-1 rounded transition-colors"
                role="listitem"
              >
                {project.link ? (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:ring-offset-2 focus:ring-offset-gray-900 rounded"
                    aria-label={`Visit ${project.title}: ${project.description}`}
                  >
                    <div class="flex items-start gap-2">
                      <span
                        class="text-gray-400 w-6 shrink-0"
                        aria-hidden="true"
                      >
                        {String(index + 1).padStart(2, "0")}.
                      </span>
                      <span
                        class="text-yellow-360 shrink-0"
                        role="img"
                        aria-label="Project icon"
                      >
                        {project.icon}
                      </span>
                      <div class="min-w-0 flex-1">
                        <span class="text-white group-hover:text-cyan-300 font-semibold">
                          {project.title}
                        </span>
                        <span class="text-gray-500 ml-2">
                          → {project.description}
                        </span>
                      </div>
                    </div>
                  </a>
                ) : (
                  <div
                    class="flex items-start gap-2 opacity-60"
                    aria-label={`${project.title}: ${project.description} (Coming soon)`}
                  >
                    <span class="text-gray-400 w-6 shrink-0" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}.
                    </span>
                    <span
                      class="text-yellow-360 shrink-0"
                      role="img"
                      aria-label="Project icon"
                    >
                      {project.icon}
                    </span>
                    <div class="min-w-0 flex-1">
                      <span class="text-white font-semibold">
                        {project.title}
                      </span>
                      <span class="text-gray-500 ml-2">
                        → {project.description}
                      </span>
                      <span class="text-gray-600 ml-2">[coming soon]</span>
                    </div>
                  </div>
                )}
              </div>
            ))
          }
        </div>
        <div class="mt-3 pt-2 border-t border-gray-700 text-gray-500 text-xs">
          <span class="text-gray-400">$</span> ls -la projects/ | total {
            projects.length
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
