---
import { getCollection } from "astro:content";
import PostPreview from "../components/PostPreview.astro";
import SocialMediaIcons from "../components/SocialMediaIcons.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortMDByDate } from "../utils";

const MAX_POSTS = 10;
const allPosts = await getCollection("blog");
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);

const techStack: Record<string, string> = {
  cpp: "C++",
  csharp: "C#",
  java: "Java",
};

const projects: Array<{
  title: string;
  description: string;
  link: string;
}> = [
  {
    title: "Tetris clone",
    description: "Implementation of the classic puzzle game focused on rotation logic, collision handling, state management, and precise control of gameplay pacing",
    link: "https://github.com/marcar-v/Tetris",
  },
  {
    title: "Frog Plataform 2D",
    description: "Platformer game with physics-based movement, jumping, and lateral navigation, focused on level design and responsive controls.",
    link: "https://github.com/marcar-v/plataformas-2d",
  },
    {
    title: "Jelix Hump",
    description: "Casual physics-based game where the player manipulates the environment, focusing on collision detection, progression systems, and incremental difficulty scaling.",
    link: "https://github.com/marcar-v/helix-jump",
  },
    {
    title: "VR Experience (Unreal Engine)",
    description: "Immersive experience in Unreal Engine focused on virtual reality interaction, basic locomotion systems, and performance optimization.",
    link: "https://github.com/marcar-v/M06-UnrealEngine",
  },
      {
    title: "Gala Samantaro",
    description: "2D platformer game with enemies and bosses, where the player progresses through levels collecting coins and overcoming obstacles.",
    link: "https://github.com/marcar-v/final-project",
  },
      {
    title: "Clicker",
    description: "2D clicker game where the player interacts with geometric shapes to achieve maximum distance.",
    link: "https://github.com/marcar-v/Clicker",
  },
      {
    title: "Ejercicios Java",
    description: "Personal practice project aimed at learning and reinforcing fundamental Java concepts.",
    link: "https://github.com/marcar-v/java_curso",
  },
      {
    title: "Dual Cycle - In development",
    description: "Mobile app for tracking and managing multiple users’ menstrual cycles, with authentication, remote access, and cycle prediction.",
    link: "https://github.com/marcar-v/dual-cycle",
  },

];
---

<BaseLayout navbarActiveItemID="home">
  <main>
    <section id="about" class="mt-6" aria-labelledby="about-heading">
      <div
        class="bg-black/30 border border-gray-600 rounded-lg font-mono text-sm p-6"
        role="region"
      >
        <!-- Terminal header -->
        <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-600">
          <div class="flex gap-2" role="img">
            <div class="w-3 h-3 rounded-full bg-red-500"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
          </div>
          <span class="text-gray-400 text-xs ml-2"
            >terminal - ssh guest@terminus</span
          >
        </div>

        <!-- Content -->
        <div class="text-xs">
          <div class="space-y-2">
            <div class="flex items-center gap-4 mb-4">
              <p class="text-3xl">🎮</p>
              <div class="flex flex-col">
                <h1 class="text-primary text-xl">Violeta Martín</h1>
                <p class="text-gray-400 text-xs">
                  Game Developer
                </p>
              </div>
            </div>

            <!-- Personal paragraph -->
            <div class="bg-gray-500/10 rounded-lg p-3 mb-4">
              <p class="text-gray-200 leading-relaxed">
                Welcome to my game development portfolio. This space showcases my projects, experiments, and learning process, with a focus on interactive narrative, gameplay design, and software development. It documents my work across different engines and technologies, as well as my ongoing progression as both a game and software developer.
              </p>
            </div>

            <div class="border-b border-gray-600 w-full mb-2"></div>

            <div class="flex">
              <span class="text-gray-400 w-36 shrink-0">Location</span>
              <span class="text-white">Granada, Spain 🌍</span>
            </div>

            <div class="flex">
              <span class="text-gray-400 w-36 shrink-0">Work</span>
              <span class="text-white">
                Game Developer
                
              </span>
            </div>

            <div class="flex">
              <span class="text-gray-400 w-36 shrink-0">Interests</span>
              <span class="text-white"
                >Technology and programming, video games (analysis and design), board games and mechanics design, reading, especially fiction and narrative.</span
              >
            </div>

            <div class="flex">
              <span class="text-gray-400 w-36 shrink-0">Contact</span>
              <span class="text-white">
                <a
                  class="text-cyan-600 hover:underline focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:ring-offset-2 focus:ring-offset-gray-900"
                  href="mailto:violetamartinc@gmail.com"
                  aria-label="Send email to violetamartinc@gmail.com">Email me!</a
                >
              </span>
            </div>
            
            <div class="flex">
              <span class="text-gray-400 w-36 shrink-0">CV</span>
              <span class="text-white">
                <a
                  class="text-cyan-600 hover:underline focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:ring-offset-2 focus:ring-offset-gray-900"
                  href="https://drive.google.com/file/d/1ARL_6R53lez8eBhFWZ-5LzLiahRFajiF/view?usp=drive_link"
                  aria-label="https://drive.google.com/file/d/1ARL_6R53lez8eBhFWZ-5LzLiahRFajiF/view?usp=drive_link">Curriculum Vitae</a
                >
              </span>
            </div>

            <div class="flex items-center">
              <span class="text-gray-400 w-36 shrink-0">Social</span>
              <span class="text-white flex-1 min-w-0">
                <SocialMediaIcons />
              </span>
            </div>

            <div class="pt-2">
              <div class="flex items-center">
                <span class="text-gray-400 w-36 shrink-0">Tech</span>
                <div class="flex flex-wrap gap-2" role="list" aria-label="Tech">
                  {
                    Object.keys(techStack).map((lang) => (
                      <span
                        class="text-gray-400 hover:text-cyan-600 transition-colors"
                        title={techStack[lang]}
                      >
                        {lang}
                      </span>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-3 pt-2 border-t border-gray-700 text-gray-500 text-xs">
          <span class="text-gray-400">$</span> cat about.txt
        </div>
      </div>
    </section>

    <section id="projects" class="mt-2">
      <div
        class="bg-black/20 border border-gray-700 rounded font-mono text-sm text-gray-300 p-6"
        role="region"
        aria-label="Project showcase"
      >
        <h2 class="mb-4 text-sm font-bold text-gray-500">👾 my projects</h2>
        <div class="space-y-2" role="list">
          {
            projects.map((project, index) => (
              <div
                class="group hover:bg-gray-800/50 p-1 rounded transition-colors"
                role="listitem"
              >
                {project.link ? (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block focus:outline-none focus:ring-2 focus:ring-cyan-600 focus:ring-offset-2 focus:ring-offset-gray-900 rounded"
                    aria-label={`Visit ${project.title}: ${project.description}`}
                  >
                    <div class="flex items-start gap-2">
                      <span
                        class="text-gray-400 w-6 shrink-0"
                        aria-hidden="true"
                      >
                        {String(index + 1).padStart(2, "0")}.
                      </span>
                      <span
                        class="text-yellow-360 shrink-0"
                        role="img"
                        aria-label="Project icon"
                      >
                      </span>
                      <div class="min-w-0 flex-1">
                        <span class="text-white group-hover:text-cyan-300 font-semibold">
                          {project.title}
                        </span>
                        <span class="text-gray-500 ml-2">
                          → {project.description}
                        </span>
                      </div>
                    </div>
                  </a>
                ) : (
                  <div
                    class="flex items-start gap-2 opacity-60"
                    aria-label={`${project.title}: ${project.description} (Coming soon)`}
                  >
                    <span class="text-gray-400 w-6 shrink-0" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}.
                    </span>
                    <span
                      class="text-yellow-360 shrink-0"
                      role="img"
                      aria-label="Project icon"
                    >
                    </span>
                    <div class="min-w-0 flex-1">
                      <span class="text-white font-semibold">
                        {project.title}
                      </span>
                      <span class="text-gray-500 ml-2">
                        → {project.description}
                      </span>
                      <span class="text-gray-600 ml-2">[coming soon]</span>
                    </div>
                  </div>
                )}
              </div>
            ))
          }
        </div>
        <div class="mt-3 pt-2 border-t border-gray-700 text-gray-500 text-xs">
          <span class="text-gray-400">$</span> ls -la projects/ | total {
            projects.length
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
